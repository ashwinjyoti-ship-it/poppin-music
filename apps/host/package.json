{
  "name": "@poppin/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,magenta \"tsx src/api/server.ts\" \"vite\"",
    "dev:desktop": "concurrently -k -n api,ui,app -c blue,magenta,green \"tsx src/api/server.ts\" \"vite\" \"wait-on http://127.0.0.1:5173 http://127.0.0.1:47821/api/status && electron ./electron/main.mjs\"",
    "build": "vite build"
  },
  "dependencies": {
    "@poppin/daw-bridge": "workspace:*",
    "@poppin/musical-engine": "workspace:*",
    "@poppin/pmr": "workspace:*",
    "@poppin/session-agents": "workspace:*",
    "@poppin/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  }
}
