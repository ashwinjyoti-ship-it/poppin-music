{
  "name": "poppin-music",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "description": "Local-first musical intelligence — hear sketches in Poppin, then GarageBand or Reaper.",
  "scripts": {
    "dev": "pnpm --filter @poppin/host dev",
    "dev:desktop": "pnpm --filter @poppin/host dev:desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
